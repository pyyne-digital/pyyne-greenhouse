# ── Auth.js / Google OAuth ─────────────────────────────
AUTH_SECRET=                # `npx auth secret` ou openssl rand -base64 32
AUTH_GOOGLE_ID=             # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=         # Google Cloud OAuth client secret

# ── GitHub App (escreve propostas no repo) ─────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=     # conteúdo do .pem (use \n nas quebras de linha)
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=pyyne-digital
GITHUB_REPO_NAME=pyyne-greenhouse
