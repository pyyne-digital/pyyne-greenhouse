# ── Auth.js / Google OAuth ─────────────────────────────
# While AUTH_GOOGLE_ID is unset, the app runs in AUTH BYPASS mode:
# everyone is automatically signed in as the first admin in admins.json.
AUTH_SECRET=                # `npx auth secret` or openssl rand -base64 32
AUTH_GOOGLE_ID=             # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=         # Google Cloud OAuth client secret
# AUTH_BYPASS=false         # force real Google login even without credentials

# ── GitHub App (writes proposals to the repo) ──────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=     # .pem contents (use \n for line breaks)
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=pyyne-digital
GITHUB_REPO_NAME=pyyne-greenhouse
